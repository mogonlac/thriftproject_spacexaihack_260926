# Copy to .env.local and fill in. Everything is optional for a local demo:
# without Supabase the app uses an in-memory copy of lib/seed.ts,
# without Gemini the chat panel shows "assistant not configured".

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey) — server only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional 4-digit PIN for /staff
STAFF_PIN=

# Shown on the receipt
NEXT_PUBLIC_SHOP_NAME=Oxfam Shop
