# One env file for both apps: copy to .env.local at the repo root.
# (Each app also reads its own storefront/.env.local or scanner/.env.local, which win if present.)
# Everything is optional for a local demo: without Supabase both apps share the JSON store in .data/.

# --- Gemini (server-only) ---------------------------------------------------
# Used by the storefront assistant AND the scanner's garment analysis.
GEMINI_API_KEY=
# Storefront shopping assistant model (default gemini-flash-latest)
# ASSISTANT_MODEL=gemini-flash-latest
# Scanner vision model (default gemini-3.5-flash-lite, ~3 s per garment)
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Scanner: alternative AI + market pricing (optional) ---------------------
# Claude is used if there's no Gemini key, or ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANALYSIS_PROVIDER=gemini | anthropic | fallback
# Tavily web search over UK resale listings (eBay, Vinted, Depop) to price items without a tag
TAVILY_API_KEY=

# --- Shared inventory: Supabase (optional) ------------------------------------
# Run storefront/supabase/schema.sql, seed.sql, then scanner/supabase/scanner.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- App settings ---------------------------------------------------------------
# Shown on printed receipts
NEXT_PUBLIC_SHOP_NAME=Oxfam Shop
# Optional PIN for the storefront's /staff till
STAFF_PIN=
# Rack quick-pick buttons on the scanner, and its station label
NEXT_PUBLIC_RACKS=A1,A2,A3,B1,B2,B3,B4,C1,C2,C3,D1,D2
NEXT_PUBLIC_STATION_ID=stockroom-1
# Cross-links between the apps (set to the deployed URLs in production)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_SCANNER_URL=http://localhost:3001
# Override where the shared local demo store lives (default: <repo>/.data)
# THRIFT_DATA_DIR=
