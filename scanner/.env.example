# --- AI garment analysis (server-side only) ---
ANTHROPIC_API_KEY=
# Optional: override the vision model (default claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
# Set to "fallback" to skip the AI entirely (offline demo; items flagged needs_review)
# ANALYSIS_PROVIDER=fallback

# --- Shared inventory (same Supabase project as the storefront) ---
# Leave blank to store items in ./data/items.json instead (local demo mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scanner station ---
# Comma-separated rack codes shown as quick-pick buttons
NEXT_PUBLIC_RACKS=A1,A2,B1,B2,B3,C1,C2,D1
# Label written to items.scan_source
NEXT_PUBLIC_STATION_ID=stockroom-1
